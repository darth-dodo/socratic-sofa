# Socratic Sofa Environment Variables

# Required: Anthropic API Key for Claude LLM
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Optional: Claude model for the CrewAI agents (read by CrewAI from MODEL)
# MODEL=anthropic/claude-sonnet-4-5

# Optional: Gradio server configuration (for local development)
# GRADIO_SERVER_NAME=0.0.0.0
# GRADIO_SERVER_PORT=7860
